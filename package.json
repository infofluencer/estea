{
  "name": "estea",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -n landing,shop -c green,yellow \"npm:dev:landing\" \"npm:dev:shop\"",
    "dev:landing": "npm run dev -w @estea/landing",
    "dev:shop": "npm run dev -w @estea/shop",
    "build": "npm run build --workspaces --if-present",
    "build:landing": "npm run build -w @estea/landing",
    "build:shop": "npm run build -w @estea/shop",
    "start:landing": "npm run start -w @estea/landing",
    "start:shop": "npm run start -w @estea/shop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps packages"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "oxlint": "^1.79.0"
  }
}
