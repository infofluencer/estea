# Dokploy: Build Path: /, Docker File: Dockerfile.landing, container port 3020.
# Lokal: docker build -f Dockerfile.landing --build-arg NEXT_PUBLIC_SHOP_URL=http://localhost:3015 .
# Nixpacks alternatifi: nixpacks.landing.toml (artık tercih edilmiyor; Dockerfile üçlüyle aynı akış).

# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS deps
WORKDIR /app
# Workspace manifestleri: npm ci lock'u tüm workspace'lerle doğrular.
COPY package.json package-lock.json ./
COPY apps/landing/package.json apps/landing/
COPY apps/shop/package.json apps/shop/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
ARG GIT_COMMIT=unknown
ARG CACHE_BUST=unknown
ARG BUILD_TIMESTAMP=unknown
RUN echo "cache_bust=${CACHE_BUST} commit=${GIT_COMMIT} built=${BUILD_TIMESTAMP}"
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ui ./packages/ui
COPY apps/landing ./apps/landing
# Build anında gömülür: mağaza linkleri ("Çaylarımız"). Domain gelince değiştir → rebuild.
ARG NEXT_PUBLIC_SHOP_URL
ENV NEXT_PUBLIC_SHOP_URL=$NEXT_PUBLIC_SHOP_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build:landing

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3020
ENV HOSTNAME=0.0.0.0
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
# outputFileTracingRoot = repo kökü → standalone içinde apps/landing/server.js
COPY --from=builder /app/apps/landing/.next/standalone ./
COPY --from=builder /app/apps/landing/.next/static ./apps/landing/.next/static
COPY --from=builder /app/apps/landing/public ./apps/landing/public
EXPOSE 3020
CMD ["node", "apps/landing/server.js"]
