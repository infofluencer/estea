KDV_RATE=1

# BizimHesap fatura — Es Çay'ın kendi hesabı (K14). https://apidocs.bizimhesap.com/addinvoice
# Boş bırakılırsa mock mod: gerçek HTTP atılmaz; delivery.created → mock kayıt + order metadata.
