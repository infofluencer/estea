# BizimHesap stok eşitlemesi (5 dk'da bir, BizimHesap → Medusa). Token boşsa kapalı.
# İlk bağlantı: npm run test:bizimhesap:stock (stoğa yazmaz, gerçek yanıtı gösterir).
# BIZIMHESAP_TOKEN=
# Tek depo varsa otomatik bulunur.
# BIZIMHESAP_WAREHOUSE_ID=
# true olmadan yalnız rapor üretir. true iken admindeki elle stok değişikliklerinin üzerine yazılır.
# BIZIMHESAP_STOCK_APPLY=false
# Yanıttaki alan adları varsayılan adaylara uymazsa (ör. SKU barkodla eşleşiyorsa barcode)
# BIZIMHESAP_STOCK_SKU_FIELD=
# BIZIMHESAP_STOCK_QUANTITY_FIELD=
# Birden çok Medusa stok konumu varsa
# BIZIMHESAP_STOCK_LOCATION_ID=
# Tek turda sıfırlanabilecek varyant oranı; aşılırsa hiçbir şey yazılmaz (1 = koruma kapalı)
# BIZIMHESAP_STOCK_MAX_ZERO_RATIO=0.5

