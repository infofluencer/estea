# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Redis (cache + event bus)
REDIS_URL=redis://localhost:6379

# Worker mode: shared | server | worker
MEDUSA_WORKER_MODE=shared

# Auth / session secrets
# ⚠️  PROD'DA MUTLAKA RANDOM ÜRET — placeholder bırakma (bilinen değerle sahte token üretilebilir)
# Üretim komutu (her biri için ayrı çalıştır):
#   openssl rand -base64 32
# JWT_SECRET ile COOKIE_SECRET farklı olmalı.
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret
# HTTP IP admin için false. Domain + HTTPS gelince silin veya true yapın.
# COOKIE_SECURE=false

# CORS — comma-separated origins (local defaults below)
STORE_CORS=http://localhost:8000,http://localhost:3025
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:3025
# Staging örnek: STORE_CORS/AUTH_CORS içine http://STAGING_IP:3016 ekleyin
# Prod örnekleri (Dokploy'da localhost yerine bunları kullanın):
# STORE_CORS=https://market.esteacay.com,https://www.market.esteacay.com
# ADMIN_CORS=https://api.esteacay.com
# AUTH_CORS=https://market.esteacay.com,https://www.market.esteacay.com,https://api.esteacay.com

# Staging smoke (HTTP, prod'a ASLA gitmez):
#   STAGING_BACKEND_URL=http://STAGING_IP:9000
#   STAGING_PUBLISHABLE_KEY=pk_...
#   STAGING_FRONTEND_URL=http://STAGING_IP:3016
#   STAGING_ADMIN_EMAIL=... STAGING_ADMIN_PASSWORD=...
#   npm run test:staging:backend

# Medusa integration tests (medusaIntegrationTestRunner — ephemeral DB):
# Docker: docker compose -f docker-compose.dev.yml up -d
#   DATABASE_URL=postgres://medusa:medusa@localhost:5433/escay
#   REDIS_URL=redis://localhost:6380
#   JWT_SECRET=test
#   COOKIE_SECRET=test
#   STORE_CORS=http://localhost:3025
#   AUTH_CORS=http://localhost:3025
#   ADMIN_CORS=http://localhost:9000
#   npm run test:integration:http
# Hızlı katalog: INTEGRATION_PRODUCT_COUNT=5 npm run test:integration:http

# Storefront public URL (PayTR ok/fail, email linkleri, Medusa admin storefrontUrl)
# Local: http://localhost:3025
# Prod:  https://market.esteacay.com (K8)
STOREFRONT_URL=http://localhost:3025

# Contact form + ops inboxes (defaults in code if unset)
# CONTACT_INBOX=info@esteacay.com
# RETURNS_INBOX=info@esteacay.com

# Optional rate-limit tunables (defaults in code — only set to tighten/loosen)
# AUTH_LOGIN_RATE_MAX=10
# AUTH_LOGIN_RATE_WINDOW_MS=600000
# AUTH_REGISTER_RATE_MAX=10
# AUTH_REGISTER_RATE_WINDOW_MS=600000
# AUTH_PASSWORD_RESET_RATE_MAX=5
# AUTH_PASSWORD_RESET_RATE_WINDOW_MS=600000
# AUTH_PASSWORD_UPDATE_RATE_MAX=5
# AUTH_PASSWORD_UPDATE_RATE_WINDOW_MS=600000
# GUEST_RETURN_RATE_MAX=8
# GUEST_RETURN_RATE_WINDOW_MS=600000
# ORDER_LOOKUP_RATE_MAX=30
# ORDER_LOOKUP_RATE_WINDOW_MS=600000

# PayTR iFrame API credentials
# Mağaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri sayfasından alın
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1=test mode (gerçek para çekilmez), 0=canlı mod. HER ORTAMDA AÇIKÇA YAZIN:
# tanımsızken sessizce test modu olur; NODE_ENV=production'da tanımsızsa boot durur.
PAYTR_TEST_MODE=1
# Canlı dışı ortam işareti (staging: STG). Doluysa merchant_oid bu önekle başlar,
# get-token yalnızca PAYTR_TEST_MODE=1 ile atılır, gerçek /odeme/iade engellenir,
# Meta CAPI / Omnisend olayları gitmez. Prod'da BOŞ bırakın (varsayılan önek "M").
# PAYTR_TEST_MODE=0 + PAYTR_OID_PREFIX dolu → boot'ta hata (src/modules/paytr/env-guard.ts).
PAYTR_OID_PREFIX=
# Env doğrulamasını prod dışında da zorla (hata → süreç başlamaz): PAYTR_ENV_STRICT=1
# PAYTR_ENV_STRICT=
# Tutarsız success (iptal siparişe geç success, tutar farkı, siparişsiz session):
# varsayılan OTOMATİK İADE YOK — uyarı maili + elle inceleme (session manual_review=true).
# 1 → eski davranış: /odeme/iade ile otomatik telafi.
# PAYTR_CALLBACK_AUTO_REFUND=
# Kritik PayTR tutarsızlık alarmı (geç success, tutar sapması). Yoksa RETURNS_INBOX / CONTACT_INBOX.
# PAYTR_ALERT_INBOX=info@esteacay.com
# Callback flood: varsayılan 180 istek / 60 sn / IP
# PAYTR_CALLBACK_RATE_MAX=180
# PAYTR_CALLBACK_RATE_WINDOW_MS=60000

# Havale / EFT (provider: pp_havale_havale). Varsayılan KAPALI.
# 1 + IBAN + hesap sahibi doluysa checkout'ta "Havale / EFT" seçeneği çıkar.
# Siparişler ödeme bekler; admin sipariş detayındaki "Havale alındı" ile onaylanır.
# Otomatik iptal yok. Bölgeye bağlamak için bir kez: npx medusa exec ./src/scripts/enable-bank-transfer.ts
# Havale kapalı (2026-11-07): sağlayıcı medusa-config.ts içinde yorumda; 1 yapmak tek başına açmaz.
BANK_TRANSFER_ENABLED=0
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
# get-token debug_on zorla (boşsa: test_mode=1 veya STG öneki → 1, prod → 0)
# PAYTR_DEBUG_ON=
# Lokal testte PayTR geçerli bir dış IP ister.
# https://www.whatismyip.com/ — lokal ortamda bu değeri ayarlayın.
# Sunucuda ayarlamaya gerek yok (gerçek IP otomatik alınır).
PAYTR_USER_IP=
# PayTR iframe vazgeçme/timeout: ödeme authorize/capture olmamış pending
# siparişleri bu süre sonra cancelOrderWorkflow ile iptal et (stok serbest).
# Failed callback siparişi iptal ETMEZ (müşteri aynı oturumda tekrar dener);
# süre son başarısız denemeden itibaren yeniden işler. Job: src/jobs/cancel-unpaid-paytr-orders.ts (her 10 dk).
UNPAID_ORDER_TIMEOUT_MINUTES=30

# SMTP email (Google Workspace production or Mailpit for local dev)
# Production: smtp.gmail.com:587, SMTP_SECURE=false, Google App Password required
# Local dev (Mailpit): SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false
# Başka sağlayıcı (Resend, Postmark, SES) da aynı SMTP_* ile çalışır; kod değişmez.
# Gerçek sunucu testi: SMTP_TEST_TO=adresiniz npm run test:emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@esteacay.com
# Google App Password — NOT your regular password. Generate at:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_PASS=your-google-app-password-here
SMTP_FROM=Es Çay <info@esteacay.com>
SMTP_SECURE=false

# ─── Kargo katmanı (src/modules/carrier, blueprint §4.13) ───
# Kargo firması adaptörü kodu. BOŞ = elle kargo (manual_manual): admin "Kargoya ver (takip no)"
# → müşteri mailleri. `dhl` = DHL eCommerce (Apizone, adapters/dhl); değiştirince
# `npm run seed` (shipping option → carrier_carrier).
SHIPPING_CARRIER=
# true = firma sandbox'ı (gerçek kargo/ücret yok). Canlıda false.
SHIPPING_CARRIER_TEST_MODE=true
# Ödeme sonrası otomatik kargo kaydı. Boş → adaptör varsa true, elle kargoda false.
# SHIPPING_AUTO_FULFILL=
# Kargo kaydı açılamazsa sipariş iptal edilmez; jobs/retry-auto-fulfill 30 dk'da bir yeniden dener.
# Bekleme (dk) / geriye bakış (saat) / en fazla deneme (sonra Logs'a hata, elle devam).
# SHIPPING_RETRY_GRACE_MINUTES=15
# SHIPPING_RETRY_LOOKBACK_HOURS=72
# SHIPPING_RETRY_MAX_ATTEMPTS=12
# ── DHL eCommerce (SHIPPING_CARRIER=dhl) — docs/DHL-APIZONE.md. Kimlikler Es Çay'ın KENDİ hesabı.
# Host: yalnız DHL_ENV=prod → api.mngkargo.com.tr; başka her değer sandbox (testapi.mngkargo.com.tr).
# Prod'da gönderi/iade ancak SHIPPING_CARRIER_TEST_MODE=false iken; test modunda prod'a yalnız okuma.
# DHL_ENV=
# Apizone uygulaması Client ID / Secret. Abonelikler: Identity, Standard Command, Barcode Command,
# Standard Query, CBS Info (zorunlu); Plus Command (alıcı ön kaydı), Utility (durum/hata kodları) önerilir.
# Sunucu çıkış IP'si DHL'e yetkilendirilmeli.
# Sandbox kimlikleri ayrı adla: DHL_SANDBOX_CLIENT_ID / _CLIENT_SECRET / _CUSTOMER_NUMBER / _PASSWORD.
# DHL_ENV=prod değilken bunlar kullanılır (yoksa DHL_*); canlıda hiç okunmaz.
# DHL_CLIENT_ID=
# DHL_CLIENT_SECRET=
# Müşteri no + Online Şube KALICI şifresi (Identity token'ı bunlarla alınır)
# DHL_CUSTOMER_NUMBER=
# DHL_PASSWORD=
# Etiket ZPL gelir; admin .zpl dosyası indirir, yazıcıya doğrudan basılır (docs/DHL-APIZONE.md).
# labelary = eski yol: PDF'e çevir (etiket verisi Labelary'ye gider, PDF 10x15 sayfada küçülür).
# DHL_LABEL_PDF=labelary
# Takip linki şablonu ({code} = gönderi no); DHL durum yanıtı link verince onunla değişir.
# DHL_TRACKING_URL_TEMPLATE=https://www.dhlecommerce.com.tr/gonderitakip?takipNo={code}
# Varış şubesi (20001) barkod tekrarı: aralık / gönderi açılırken en fazla bekleme (ms).
# Süre dolunca hata değil "etiket bekliyor"; yoklama (30 dk) barkodu sonra alır.
# DHL_BARCODE_RETRY_INTERVAL_MS=10000
# DHL_BARCODE_RETRY_TIMEOUT_MS=60000
# Etiket bu kadar dakikadır alınamıyorsa admin Logs'a hata
# DHL_BARCODE_PENDING_ALERT_MINUTES=120
# Sipariş öncesi createRecipient (Plus Command) — şube atamasını hızlandırır; hata gönderiyi durdurmaz
# DHL_CREATE_RECIPIENT=true
# Servis dışı mahalle: branch = alıcı şubeden alır (deliveryType 2), block = gönderi açılmaz
# DHL_OUT_OF_SERVICE=branch
# DHL SMS'leri: şubeye varınca alıcıya / hazırlanınca alıcıya / teslimde bize
# DHL_SMS_ON_ARRIVAL=true
# DHL_SMS_ON_PREPARE=false
# DHL_SMS_ON_DELIVERY=false
# İade kargo ücreti: 2 = alıcı (biz) öder, müşteri şubede ödemez; 1 = gönderen (müşteri)
# DHL_RETURN_PAYMENT_TYPE=2
# Kodlu iade mailinde müşterinin şubede söyleyeceği firma bilgisi
# RETURN_CARRIER_NAME=DHL eCommerce
# RETURN_CUSTOMER_NUMBER=
# Firma webhook sırrı (adaptör parseWebhook doğrular). Panelde:
#   https://api.<domain>/carrier/webhook?token=BU_DEGER
# CARRIER_WEBHOOK_SECRET=
# Firmaya giden sipariş referansı öneki: ESC-<display_id> (değişimde -D eki)
ORDER_REF_PREFIX=ESC-
# Varsayılan koli (kg / cm) — TODO(K1/K4): gerçek çay paketiyle ölç. Varyant metadata.weight_kg
# (gramaj) varsa ağırlık oradan gelir.
SHIPPING_PACKAGE_DEFAULT={"weight":0.5,"length":30,"width":20,"height":15,"maxHeight":45}
# Checkout ilçe gelmezse son çare (normalde boş; checkout il→ilçe→mahalle toplar)
# SHIPPING_DEFAULT_DISTRICT=
# Checkout sabit kargo ücreti (seed) ve ücretsiz kargo eşiği (0 = yok) — TODO(K4)
SHIPPING_FLAT_PRICE=149.90
# Hoş geldin kuponu (seed): boşsa oluşturulmaz. Örn. hosgeldin10 / 10
WELCOME_PROMO_CODE=
WELCOME_PROMO_PERCENT=10
FREE_SHIPPING_THRESHOLD=0
# price_type=calculated iken adaptör teklif vermezse yedek ücret
# SHIPPING_FALLBACK_PRICE=149.90

# ─── Vergi ───
