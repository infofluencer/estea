# Fatura sorunu / elle kesilecek iade faturası uyarısı (boşsa CONTACT_INBOX)
# BIZIMHESAP_ADMIN_ALERT_EMAIL=info@esteacay.com
# Fatura açıklamasına yazılan internet satış adresi (varsayılan STOREFRONT_URL)
# BIZIMHESAP_INTERNET_SALE_URL=https://market.esteacay.com
# Retry job (yalnız reddedilen istekler): BIZIMHESAP_RETRY_MAX_ATTEMPTS=8  BIZIMHESAP_RETRY_LOOKBACK_HOURS=72
