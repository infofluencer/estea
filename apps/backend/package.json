{
  "name": "escay-backend",
  "version": "0.0.1",
  "description": "Es Çay — Medusa v2 backend (PayTR, havale, Paraşüt, generic kargo katmanı)",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa",
    "escay"
  ],
  "scripts": {
    "prepare:shared": "node scripts/sync-shared.mjs",
    "prebuild": "node scripts/sync-shared.mjs && node scripts/patch-dashboard-order-filters.mjs",
    "build": "medusa build && node scripts/link-shared-module.mjs",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed-escay.ts",
    "setup:turkey": "medusa exec ./src/scripts/setup-turkey.ts",
    "setup:turkey:prod": "medusa exec ./src/scripts/setup-turkey.js",
    "enable:bank-transfer": "medusa exec ./src/scripts/enable-bank-transfer.ts",
    "enable:bank-transfer:prod": "medusa exec ./src/scripts/enable-bank-transfer.js",
    "test:bank-transfer": "medusa exec ./src/scripts/test-bank-transfer.ts",
    "test:bank-transfer:prod": "medusa exec ./src/scripts/test-bank-transfer.js",
    "ensure:publishable-key": "medusa exec ./src/scripts/ensure-publishable-key.ts",
    "ensure:publishable-key:prod": "medusa exec ./src/scripts/ensure-publishable-key.js",
    "cleanup:medusa-defaults": "medusa exec ./src/scripts/cleanup-medusa-defaults.ts",
    "auth:create-verified": "medusa exec ./src/scripts/create-verified-customer.ts",
    "auth:create-staging-remote": "npx tsx src/scripts/create-staging-customer-remote.ts",
    "seed:order-statuses": "medusa exec ./src/scripts/seed-order-status-demos.ts",
    "test:emails": "medusa exec ./src/scripts/test-emails.ts",
    "test:contracts": "PAYTR_MOCK=1 medusa exec ./src/scripts/test-order-contracts.ts",
    "test:paytr": "npx tsx src/scripts/test-paytr-hash.ts",
    "test:paytr:token": "npx tsx src/scripts/test-paytr-token.ts",
    "test:paytr:callback": "medusa exec ./src/scripts/test-paytr-callback.ts",
    "test:returns": "PAYTR_MOCK=1 npx tsx test/returns/run-all.ts",
    "test:return-refund": "npx tsx src/scripts/test-return-refund.ts",
    "test:smoke:full": "PAYTR_MOCK=1 medusa exec ./src/scripts/smoke-full-flow.ts",
    "test:smoke:link-guest": "medusa exec ./src/scripts/smoke-link-guest-orders.ts",
    "test:smoke:parasut-deep": "PAYTR_MOCK=1 medusa exec ./src/scripts/smoke-parasut-deep.ts",
    "test:parasut:draft": "PARASUT_DRY_RUN=true medusa exec ./src/scripts/test-parasut-draft.ts",
    "test:staging:backend": "npx tsx src/scripts/staging-smoke/run.ts",
    "test:staging:omnisend": "node src/scripts/omnisend-smoke.mjs",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed:prod": "medusa exec ./src/scripts/seed-escay.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/auth-emailpass": "^2.18.0",
    "@medusajs/caching": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@swc/core": "^1.7.28",
    "@tanstack/react-query": "5.64.2",
    "bcryptjs": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
