# Es Çay storefront — Türkiye / TRY (Medusa v2 BFF)
#
# Swarm / Dokploy: MEDUSA_BACKEND_URL = iç servis adı (SSR). Tarayıcı backend'i
# doğrudan çağırmaz. NEXT_PUBLIC_* değerleri build anında gömülür → Dokploy'da hem
# Environment hem Build-time Arguments'a yazın (Dockerfile.storefront ARG+ENV).

# Server-side Medusa URL (RSC / Server Actions). Swarm: http://escay-backend-xxx:9000
MEDUSA_BACKEND_URL=http://localhost:9000
# Public/browser-facing Medusa URL (yedek). Prod: https://api.esteacay.com  (TODO(K8) domain)
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key (Admin → Settings veya backend: npm run ensure:publishable-key)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
# Türkiye region id (Europe değil) — backend setup:turkey çıktısı
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_replace_me

# Canonical site (runtime) + host (build). TODO(K8): nihai domain kararı.
SITE_URL=http://localhost:3025
NEXT_PUBLIC_SITE_HOST=market.esteacay.com

# Ürün görselleri CDN kökü (sonunda / yok). Boşsa backend /static (yalnız lokal).
# NEXT_PUBLIC_S3_FILE_URL=https://<bucket>.s3.<region>.amazonaws.com

# KDV oranı (%) — yalnızca sepet "KDV dahil" gösterimi. TODO(K2): mali müşavir teyidi;
# backend region tax rate + PARASUT_DEFAULT_VAT_RATE ile aynı olmalı.
NEXT_PUBLIC_VAT_RATE=1
# Kargo ücreti yedeği (TRY) — asıl ücret Medusa shipping option'dan gelir. TODO(K4)
# NEXT_PUBLIC_SHIPPING_FALLBACK_PRICE=99.9

# Çerez onayı + takip (TODO(K7): Es Çay adına açılan hesaplar). Boş bırakılan yüklenmez.
# NEXT_PUBLIC_COOKIEYES_ID=
# NEXT_PUBLIC_GA4_ID=G-XXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=
# Omnisend (web takibi + formlar; yalnızca çerez "Pazarlama" onayıyla yüklenir)
# NEXT_PUBLIC_OMNISEND_BRAND_ID=

# Staging diagnostics (/api/staging-diag) — yalnızca staging
# ALLOW_STAGING_DIAGNOSTICS=1

# Staging E2E (Playwright) — ASLA prod URL kullanmayın (3025 / canlı domain)
# STAGING_FRONTEND_URL=http://STAGING_IP:3016
# STAGING_BACKEND_URL=http://STAGING_IP:9000
# STAGING_PUBLISHABLE_KEY=pk_...
# npm run test:staging:e2e:install && npm run test:staging:e2e
