  "/createDetailedOrder": {
   "post": {
    "tags": [
     "PlusCommand"
    ],
    "summary": "Create Detailed Order",
    "description": "'Detaylı' sipariş oluşturur. Alıcı ve gönderici bilgisi değerleri doldurulurken ya CustomerId verilir ya da Alıcı ve Gönderici'nin FullName, CityCode, DistrictCode, Address alanları ve MobilePhoneNumber, HomePhoneNumber, BussinessPhoneNumber' dan herhangi biri girilmelidir. | Creates detailed type of order. When you fill Recipient, Shipper areas either you set CustomerId or Recipient's and Shipper's FullName, CityCode, DistrictCode, Address and one of the MobilePhoneNumber, HomePhoneNumber, BussinessPhoneNumber.",
    "operationId": "CreateDetailedOrderPost",
    "consumes": [
     "application/json-patch+json",
     "application/json",
     "text/json",
     "application/*+json"
    ],
    "produces": [
     "application/json"
    ],
    "parameters": [
     {
      "name": "createDetailedOrderRequest",
      "in": "body",
      "required": false,
      "schema": {
       "$ref": "#/definitions/CreateDetailedOrderRequest"
      }
     },
     {
      "name": "x-api-version",
      "in": "header",
      "required": false,
      "type": "string"
     },
     {
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\"",
      "required": true,
      "type": "string"
     }
    ],
    "responses": {
     "200": {
      "description": "Detailed order created",
      "schema": {
       "$ref": "#/definitions/CreateDetailedOrderResponse"
      },
      "examples": {
       "application/json": {
        "orderInvoiceId": "456764543",
        "orderInvoiceDetailId": "25423565",
        "shipperBranchCode": "1345"
       }
      }
     },
     "400": {
      "description": "Bad Request"
     },
     "401": {
      "description": "Unauthorized"
     },
     "500": {
      "description": "Server Error"
     }
    }
   }
  },
